# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/basecamp

# Tracecat Integration
TRACECAT_API_URL=http://localhost:80/api
TRACECAT_API_KEY=your-api-key-here
TRACECAT_WORKSPACE_ID=default

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
